# Server
PORT=5000
NODE_ENV=development

# Frontend ka URL (CORS ke liye)
CLIENT_URL=http://localhost:5173

# PostgreSQL
# If Supabase TLS verification fails, set its root CA PEM; use literal \n for line breaks in Vercel.
DATABASE_SSL_CA=
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/booking_db

# Supabase Storage (backend only; never expose the service role key to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# JWT (production mein lamba random secret use karein)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Local demo seed only; choose a strong password before running npm run seed
DEMO_PASSWORD=

# Email (nodemailer). Khali chhor dein to email sirf console mein print hogi
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Booking App <no-reply@example.com>"

# Uploads (staff ki photo wagaira)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Business ka timezone (slots isi ke hisab se banenge)
BUSINESS_TZ=Asia/Karachi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
